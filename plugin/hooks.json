{
  "gstack-destructive-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-tool-command.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "gstack-freeze-and-swarm-lock": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-tool-write.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "gstack-skill-router": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/pre-invocation-route.mjs",
        "timeout": 5
      }
    ]
  },
  "gstack-contract-and-verify-gate": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/stop-gate.mjs",
        "timeout": 8
      }
    ]
  }
}
